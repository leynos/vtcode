{
  "name": "diapason-companion",
  "displayName": "Diapason",
  "description": "Diapason editor integration, a df12 Productions hard fork of VTCode by Vinh Nguyen focused on ACP control and observability.",
  "version": "0.1.0",
  "publisher": "df12productions",
  "repository": {
    "type": "git",
    "url": "https://github.com/leynos/vtcode"
  },
  "sponsor": {
    "url": "https://buymeacoffee.com/vinhnx"
  },
  "icon": "media/diapason-icon-marketplace.png",
  "engines": {
    "vscode": "^1.87.0"
  },
  "files": [
    "dist/**/*",
    "media/**/*",
    "LICENSE.txt"
  ],
  "categories": [
    "Other",
    "Chat",
    "AI"
  ],
  "keywords": [
    "diapason",
    "agent",
    "ai",
    "productivity",
    "coding agent",
    "terminal",
    "semantic code intelligence",
    "tree-sitter",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "ai coding",
    "code assistant",
    "rust",
    "security"
  ],
  "activationEvents": [
    "workspaceContains:config.toml",
    "onView:diapasonQuickActionsView",
    "onView:diapasonWorkspaceStatusView",
    "onCommand:diapason.openQuickActions",
    "onCommand:diapason.askAgent",
    "onCommand:diapason.askSelection",
    "onCommand:diapason.openConfig",
    "onCommand:diapason.openDocumentation",
    "onCommand:diapason.openDeepWiki",
    "onCommand:diapason.openWalkthrough",
    "onCommand:diapason.openInstallGuide",
    "onCommand:diapason.trustWorkspace",
    "onCommand:diapason.toggleHumanInTheLoop",
    "onCommand:diapason.openToolsPolicyGuide",
    "onCommand:diapason.openToolsPolicyConfig",
    "onCommand:diapason.configureMcpProviders",
    "onCommand:diapason.launchAgentTerminal",
    "onCommand:diapason.runAnalyze",
    "onCommand:diapason.runTaskTrackerTask",
    "onCommand:diapason.refreshQuickActions"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Diapason limits CLI automation to trusted workspaces.",
      "restrictedConfigurations": [
        "diapason.commandPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "diapason-config",
        "aliases": [
          "Diapason Config",
          "config.toml"
        ],
        "filenames": [
          "config.toml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "diapason-config",
        "scopeName": "source.toml",
        "path": "./syntaxes/diapason.tmLanguage.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "diapason",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "task-tracker"
            ],
            "description": "Diapason CLI command to execute."
          },
          "summary": {
            "type": "string",
            "description": "Optional summary passed to the task_tracker tool."
          },
          "steps": {
            "type": "array",
            "description": "Optional list of plan steps provided to task_tracker.",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string",
            "description": "Custom label displayed in the Run Task picker."
          }
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "diapason-taskTracker",
        "displayName": "Diapason Task Tracker",
        "modelDescription": "Synchronize the workspace TODO plan using the Diapason CLI task_tracker workflow.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "description": "Brief summary of the desired plan update."
            },
            "steps": {
              "type": "array",
              "description": "Optional list of plan steps to include when updating the workspace plan.",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "diapason.workspaceMcp",
        "label": "Diapason Workspace MCP Providers"
      }
    ],
    "commands": [
      {
        "command": "diapason.openQuickActions",
        "title": "Open Quick Actions",
        "category": "Diapason",
        "icon": "$(rocket)"
      },
      {
        "command": "diapason.trustWorkspace",
        "title": "Trust Workspace for Diapason",
        "category": "Diapason",
        "icon": "$(shield)"
      },
      {
        "command": "diapason.verifyWorkspaceTrust",
        "title": "Verify Workspace Trust Flow",
        "category": "Diapason",
        "icon": "$(shield-check)"
      },
      {
        "command": "diapason.flushIdeContextSnapshot",
        "title": "Refresh IDE Context Snapshot",
        "category": "Diapason",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "diapason.askAgent",
        "title": "Ask the Agent",
        "category": "Diapason",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "diapason.askSelection",
        "title": "Ask About Selection",
        "shortTitle": "Ask with Diapason",
        "category": "Diapason",
        "icon": "$(comment)"
      },
      {
        "command": "diapason.openConfig",
        "title": "Open Configuration",
        "category": "Diapason",
        "icon": "$(gear)"
      },
      {
        "command": "diapason.openDocumentation",
        "title": "Open Documentation",
        "category": "Diapason",
        "icon": "$(book)"
      },
      {
        "command": "diapason.openDeepWiki",
        "title": "Open DeepWiki Overview",
        "category": "Diapason",
        "icon": "$(globe)"
      },
      {
        "command": "diapason.openWalkthrough",
        "title": "Getting Started Walkthrough",
        "category": "Diapason",
        "icon": "$(question)"
      },
      {
        "command": "diapason.refreshQuickActions",
        "title": "Refresh Quick Actions",
        "category": "Diapason",
        "icon": "$(refresh)"
      },
      {
        "command": "diapason.openInstallGuide",
        "title": "View CLI Installation Guide",
        "category": "Diapason",
        "icon": "$(tools)"
      },
      {
        "command": "diapason.launchAgentTerminal",
        "title": "Launch Agent Terminal",
        "category": "Diapason",
        "icon": "$(terminal)"
      },
      {
        "command": "diapason.runAnalyze",
        "title": "Analyse Workspace",
        "category": "Diapason",
        "icon": "$(pulse)"
      },
      {
        "command": "diapason.runTaskTrackerTask",
        "title": "Run Task Tracker with Diapason Task",
        "category": "Diapason",
        "icon": "$(checklist)"
      },
      {
        "command": "diapason.toggleHumanInTheLoop",
        "title": "Toggle Human-in-the-Loop",
        "category": "Diapason",
        "icon": "$(shield)"
      },
      {
        "command": "diapason.openToolsPolicyGuide",
        "title": "Open Tool Policy Guide",
        "category": "Diapason",
        "icon": "$(book)"
      },
      {
        "command": "diapason.openToolsPolicyConfig",
        "title": "Open Tool Policy Configuration",
        "category": "Diapason",
        "icon": "$(settings-gear)"
      },
      {
        "command": "diapason.configureMcpProviders",
        "title": "Configure MCP Providers",
        "category": "Diapason",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "diapason.askSelection",
          "when": "editorHasSelection && diapason.cliAvailable && diapason.workspaceTrusted",
          "group": "navigation@20"
        }
      ],
      "editor/title": [
        {
          "command": "diapason.askSelection",
          "when": "editorHasSelection && diapason.cliAvailable && diapason.workspaceTrusted",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "diapason.askAgent",
          "when": "diapason.cliAvailable && diapason.workspaceTrusted"
        },
        {
          "command": "diapason.askSelection",
          "when": "editorHasSelection && diapason.cliAvailable && diapason.workspaceTrusted"
        },
        {
          "command": "diapason.launchAgentTerminal",
          "when": "diapason.cliAvailable && diapason.workspaceTrusted"
        },
        {
          "command": "diapason.runAnalyze",
          "when": "diapason.cliAvailable && diapason.workspaceTrusted"
        },
        {
          "command": "diapason.openInstallGuide",
          "when": "!diapason.cliAvailable || !diapason.workspaceTrusted"
        },
        {
          "command": "diapason.toggleHumanInTheLoop",
          "when": "diapason.configAvailable && diapason.workspaceTrusted"
        },
        {
          "command": "diapason.openToolsPolicyConfig",
          "when": "diapason.configAvailable"
        },
        {
          "command": "diapason.runTaskTrackerTask",
          "when": "diapason.cliAvailable && diapason.workspaceTrusted"
        },
        {
          "command": "diapason.openToolsPolicyGuide"
        },
        {
          "command": "diapason.configureMcpProviders",
          "when": "diapason.configAvailable && diapason.workspaceTrusted"
        }
      ],
      "view/title": [
        {
          "command": "diapason.refreshQuickActions",
          "when": "view == diapasonQuickActionsView",
          "group": "navigation@10"
        },
        {
          "command": "diapason.openWalkthrough",
          "when": "view == diapasonQuickActionsView",
          "group": "navigation@20"
        },
        {
          "command": "diapason.openInstallGuide",
          "when": "view == diapasonQuickActionsView && (!diapason.cliAvailable || !diapason.workspaceTrusted)",
          "group": "navigation@30"
        },
        {
          "command": "diapason.launchAgentTerminal",
          "when": "view == diapasonQuickActionsView && diapason.cliAvailable && diapason.workspaceTrusted",
          "group": "navigation@15"
        },
        {
          "command": "diapason.runAnalyze",
          "when": "view == diapasonQuickActionsView && diapason.cliAvailable && diapason.workspaceTrusted",
          "group": "navigation@25"
        },
        {
          "command": "diapason.runTaskTrackerTask",
          "when": "view == diapasonQuickActionsView && diapason.cliAvailable && diapason.workspaceTrusted",
          "group": "navigation@18"
        },
        {
          "command": "diapason.configureMcpProviders",
          "when": "view == diapasonQuickActionsView && diapason.configAvailable && diapason.workspaceTrusted",
          "group": "navigation@35"
        },
        {
          "command": "diapason.toggleHumanInTheLoop",
          "when": "view == diapasonQuickActionsView && diapason.configAvailable && diapason.workspaceTrusted",
          "group": "navigation@40"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diapason",
          "title": "Diapason",
          "icon": "media/diapason-activitybar.svg",
          "when": "workbenchState != 'empty'"
        }
      ],
      "secondary": [
        {
          "id": "diapason",
          "title": "Diapason",
          "icon": "media/diapason-activitybar.svg",
          "when": "workbenchState != 'empty'"
        }
      ]
    },
    "views": {
      "diapason": [
        {
          "id": "diapasonWorkspaceStatusView",
          "name": "Workspace Status",
          "when": "workbenchState != 'empty'"
        },
        {
          "id": "diapasonQuickActionsView",
          "name": "Quick Actions",
          "when": "workbenchState != 'empty'"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "diapason.walkthrough",
        "title": "Get started with Diapason",
        "description": "Learn how Diapason streamlines agent collaboration inside VS Code.",
        "steps": [
          {
            "id": "diapason.walkthrough.quickActions",
            "title": "Open quick actions",
            "description": "Use the Diapason quick actions view or command palette to explore helpful shortcuts.",
            "media": {
              "type": "markdown",
              "markdown": "Use **Diapason: Open Quick Actions** from the Command Palette or the status bar to explore available shortcuts."
            },
            "completionEvents": [
              "onCommand:diapason.openQuickActions"
            ]
          },
          {
            "id": "diapason.walkthrough.askAgent",
            "title": "Ask the Diapason agent",
            "description": "Send a question from VS Code and review the response in the Diapason output channel.",
            "media": {
              "type": "markdown",
              "markdown": "Select **Diapason: Ask the Agent** to stream a response directly into the Diapason output channel."
            },
            "completionEvents": [
              "onCommand:diapason.askAgent"
            ]
          },
          {
            "id": "diapason.walkthrough.askSelection",
            "title": "Ask about highlighted code",
            "description": "Highlight code and ask Diapason to summarize or explain the selection.",
            "media": {
              "type": "markdown",
              "markdown": "Highlight a block of code, right-click, and choose **Ask About Selection with Diapason**."
            },
            "completionEvents": [
              "onCommand:diapason.askSelection"
            ]
          },
          {
            "id": "diapason.walkthrough.config",
            "title": "Review config.toml",
            "description": "Open your workspace configuration to adjust Diapason preferences.",
            "media": {
              "type": "markdown",
              "markdown": "Run [Diapason: Open Configuration](command:diapason.openConfig) to jump directly into the workspace `config.toml`."
            },
            "completionEvents": [
              "onCommand:diapason.openConfig"
            ]
          }
        ]
      }
    ],
    "colors": [
      {
        "id": "diapason.statusBarBackground",
        "description": "Background colour for the Diapason status bar entry when the CLI is available.",
        "defaults": {
          "dark": "#1D4ED8",
          "light": "#2563EB",
          "highContrast": "#1E40AF"
        }
      },
      {
        "id": "diapason.statusBarForeground",
        "description": "Foreground colour for the Diapason status bar entry when the CLI is available.",
        "defaults": {
          "dark": "#FFFFFF",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Diapason",
      "properties": {
        "diapason.commandPath": {
          "type": "string",
          "default": "diapason",
          "description": "Executable used to run Diapason commands. Change this if Diapason is installed with a custom path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo \"Skipping build - using precompiled files\"",
    "bundle": "node ./esbuild.mjs",
    "compile": "echo \"Skipping compilation - using precompiled files\"",
    "watch": "node ./esbuild.mjs --watch",
    "typecheck": "echo \"Skipping typecheck - using precompiled files\"",
    "lint": "echo \"Skipping lint - using precompiled files\"",
    "test": "echo \"Skipping tests - using precompiled files\"",
    "test:paths": "bun test ./src/test/userDataPaths.test.ts",
    "package": "vsce package",
    "release": "./release.sh",
    "release:patch": "./release.sh patch",
    "release:minor": "./release.sh minor",
    "release:major": "./release.sh major"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^24.9.1",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.38.0",
    "glob": "^11.0.3",
    "mocha": "^11.7.4",
    "ovsx": "^0.10.9",
    "typescript": "^5.3.3"
  },
  "author": "df12 Productions (hard fork of VTCode by Vinh Nguyen)"
}
